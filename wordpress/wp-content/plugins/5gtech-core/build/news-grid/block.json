{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "g5tech/news-grid",
  "title": "Naujienų tinklelis",
  "category": "theme",
  "icon": "grid-view",
  "parent": [
    "g5tech/section"
  ],
  "supports": {
    "html": false,
    "reusable": false
  },
  "attributes": {
    "limit": {
      "type": "integer",
      "default": 12
    },
    "emptyText": {
      "type": "string",
      "default": "Naujų įrašų šiuo metu nėra."
    }
  },
  "textdomain": "5gtech-core",
  "editorScript": "file:./index.js"
}