{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "g5tech/section",
  "title": "Turinio sekcija",
  "category": "theme",
  "icon": "align-wide",
  "description": "Sekcija su žyma, antrašte ir turiniu.",
  "supports": {
    "html": false,
    "reusable": false
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "default": "light",
      "enum": [
        "light",
        "paper",
        "dark"
      ]
    },
    "anchorId": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "5gtech-core",
  "editorScript": "file:./index.js"
}